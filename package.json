{
  "name": "wardrobe",
  "version": "1.0.0",
  "private": true,
  "description": "A local-first AI wardrobe gallery powered by OpenAI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "NODE_ENV=development node server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "check": "node --check server/index.mjs && node --check server/openai-images.mjs && node --check server/outfits.mjs && node --check scripts/import-job-api.mjs && npm run build && node scripts/check-client-secrets.mjs",
    "test": "node --test",
    "auth:hash-password": "node scripts/hash-password.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "db:check": "node scripts/check-database.mjs",
    "storage:check": "node scripts/check-storage.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "security:audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@phosphor-icons/react": "^2.1.10",
    "@unpic/react": "^1.0.2",
    "@vitejs/plugin-react": "5.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "heic-to": "^1.4.2",
    "helmet": "^8.3.0",
    "ipx": "^3.1.1",
    "mysql2": "^3.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sharp": "^0.34.5",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "supertest": "^7.2.2"
  }
}

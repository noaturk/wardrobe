NODE_ENV=production
PORT=3000
APP_ORIGIN=https://wardrobe.noaturk.from.hr
TRUST_PROXY=1

ADMIN_USERNAME=noa
ADMIN_PASSWORD_HASH=
ADMIN_TOTP_SECRET=
SESSION_SECRET=
SESSION_TTL_HOURS=12

OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
OPENAI_TIMEOUT_MS=90000
MAX_CONCURRENT_OPENAI_JOBS=1
# 0 disables the app-level cap; any positive integer is a manual daily cap.
DAILY_IMAGE_GENERATION_LIMIT=0

MAX_UPLOAD_MB=10
MAX_IMAGE_PIXELS=40000000
WARDROBE_DATA_DIR=
WARDROBE_MODEL_REFERENCE=

DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_CONNECTION_LIMIT=5
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=../wardrobe-private
ALLOW_LOCAL_PRODUCTION_STORAGE=true
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

WARDROBE_BACKUP_DIR=../wardrobe-backups
